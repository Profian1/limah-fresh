# ── SMTP (cPanel / hosting provider) ────
# Port 465 uses implicit TLS (secure). Port 587 uses STARTTLS.
SMTP_HOST=smtp.yourdomain.co.ke
SMTP_PORT=465
SMTP_USERNAME=info@limahfresh.co.ke
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Limah Fresh <info@limahfresh.co.ke>"
SMTP_REPLY_TO=info@limahfresh.co.ke

# ── Admin Notifications ────────────────
ADMIN_EMAIL=info@limahfresh.co.ke

# ── Frontend ───────────────────────────
VITE_API_URL=/backend/api
VITE_SITE_URL=https://limahfresh.co.ke
